{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "loppi",
  "version": "0.1.20",
  "identifier": "app.loppi.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "loppi",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 18
        },
        "width": 1120,
        "height": 760,
        "minWidth": 760,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist",
      "files": {
        "Library/LoginItems/LoppiCore.app": "../build/macos/LoppiCore.app",
        "MacOS/loppi": "../build/macos/loppi"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBQzFCRkIxMUE3NTZFRUIKUldUcmJuVWFzYi9CdWtSb2NndklrbE1xUy9TM1Q1aDVSU29XSTlRb253cjRGTXZsWEdWVG9FcTIK",
      "endpoints": [
        "https://github.com/hAcKlyc/loppi/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
